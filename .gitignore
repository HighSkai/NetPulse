# --- Python environments, caches and build output ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.ruff_cache/
.mypy_cache/

# --- Tests and test output: kept locally, not published ---
tests/
test/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Runtime data: databases, upgrade backups, certificates and packet captures ---
# NetPulse's database and its upgrade copies (netpulse.vN-backup-*.db) hold your
# devices, history and accounts. The -tls folder holds your certificate
# authority's private key. Captures hold whatever the packets carried.
*.db
*.db-wal
*.db-shm
*-tls/
*-captures/
*.pcap
*.pcapng

# --- Logs, temporary files and crash dumps ---
*.log
*.tmp
*.bak
*.dmp

# --- Secrets and local configuration ---
.env
.env.*
*.pem
*.key

# --- Kept locally: documentation, planning notes and CI ---
# The repository holds what NetPulse needs to run, plus the README's screenshots.
docs/*
!docs/assets/
.github/

# --- Editors, AI tooling and operating systems ---
.idea/
.vscode/
*.code-workspace
.claude/
CLAUDE.md
.DS_Store
Thumbs.db
desktop.ini
